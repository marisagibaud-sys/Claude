ns-serif\"></span></p></td><td width=\"396\" valign=\"top\" style=\"width:297.0pt; border-top:none; border-left:none; border-bottom:solid windowtext 1.0pt; border-right:solid windowtext 1.0pt; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">None</span></p></td></tr><tr><td width=\"155\" valign=\"top\" style=\"width:116.6pt; border:solid windowtext 1.0pt; border-top:none; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">FTE Hours:</span></b></p></td><td width=\"396\" valign=\"top\" style=\"width:297.0pt; border-top:none; border-left:none; border-bottom:solid windowtext 1.0pt; border-right:solid windowtext 1.0pt; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">.90</span></p></td></tr><tr><td width=\"155\" valign=\"top\" style=\"width:116.6pt; border:solid windowtext 1.0pt; border-top:none; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Reports to:</span></b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\"></span></p></td><td width=\"396\" valign=\"top\" style=\"width:297.0pt; border-top:none; border-left:none; border-bottom:solid windowtext 1.0pt; border-right:solid windowtext 1.0pt; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Clinical Manager</span></p></td></tr><tr><td width=\"155\" valign=\"top\" style=\"width:116.6pt; border:solid windowtext 1.0pt; border-top:none; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Job Description Status:</span></b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\"> <b></b></span></p></td><td width=\"396\" valign=\"top\" style=\"width:297.0pt; border-top:none; border-left:none; border-bottom:solid windowtext 1.0pt; border-right:solid windowtext 1.0pt; padding:0in 5.4pt 0in 5.4pt\"><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Complete, information for position template indicated below:</span></p></td></tr></tbody></table><p class=\"MsoNormal\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif\">&nbsp;</span></p><p class=\"MsoNormal\" style=\"margin-left:.5in; line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">&nbsp;</span></p><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Position Summary:</span></b></p><ul type=\"disc\" style=\"margin-top:0in\"><li class=\"MsoListParagraph\" style=\"margin-bottom:12.0pt; margin-left:0in\">The Robotics Coordinator/RNFA Trainee functions as a Registered Nurse in the Operating Room while developing the clinical, technical, and operational knowledge, skills, and competencies necessary to perform the responsibilities of the Robotics Coordinator/RNFA role. Working under the direction of Surgical Services leadership, the incumbent provides direct patient care and progressively assumes additional responsibilities in support of robotic surgical services.<b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\"></span></b></li></ul><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Education:</span></b></p><ul type=\"disc\" style=\"margin-top:0in\"><li class=\"MsoNormal\" style=\"line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">Associate’s degree in Nursing (ADN) is required</span></li><li class=\"MsoNormal\" style=\"line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">Bachelor’s degree in Nursing (BSN) is required within two (2) years of date of hire or transfer into role.</span></li></ul><p class=\"MsoNormal\" style=\"margin-left:.5in; line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">&nbsp;</span></p><p class=\"MsoNormal\" style=\"margin-left:.5in; line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">&nbsp;</span></p><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">License and/or certification::</span></b></p><ul type=\"disc\" style=\"margin-top:0in\"><li class=\"MsoListParagraph\" style=\"margin-bottom:12.0pt; margin-left:0in\">Licensed and currently registered to practice as a Registered Nurse in the state of residency<b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\"> </span></b></li></ul><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Experience:</span></b></p><ul type=\"disc\" style=\"margin-top:0in\"><li class=\"MsoNormal\" style=\"line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">Minimum one (1) year of Operating Room Nursing experience is required.</span></li><li class=\"MsoNormal\" style=\"line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">Robotic surgery experience preferred.</span></li></ul><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">&nbsp;</span></p><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif\">Schedule:</span></b></p><ul type=\"disc\" style=\"margin-top:0in\"><li class=\"MsoNormal\" style=\"line-height:115%\"><span style=\"font-size:10.0pt; line-height:115%; font-family:&quot;Arial&quot;,sans-serif\">May be assigned to day, evening, or night shifts or a combination per departmental policy.</span></li></ul><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">&nbsp;</span></p><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#003A70\">Filippa Etherton, SHRM-SCP<br></span></b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#003A70\">Compensation Manager<br>Human Resources<br><b>TidalHealth<br>O </b>410-912-6744<br>mytidalhealth.org</span></p><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#003A70\">&nbsp;</span></p><p class=\"MsoNormal\"><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#003A70\">Have a question for HR? Submit a ticket to Shared Services;</span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt; font-family:&quot;Segoe Script&quot;\">&nbsp;</span></p><p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt; font-family:&quot;Arial&quot;,sans-serif; color:#003A70\"><a href=\"https://apps.powerapps.com/play/e/default-ff279a42-1cb6-4542-b65a-95186f081fd8/a/7f4b8c55-c804-4afa-93c3-f7308ddcbdae?tenantId=ff279a42-1cb6-4542-b65a-95186f081fd8&amp;hint=384e5157-8ea1-4b5c-912b-4a3979a7f5f3&amp;source=sharebutton&amp;sourcetime=1769439969989\">HR Questions &amp; Answers</a></span></b><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"></span></p><p class=\"MsoNormal\">&nbsp;</p></div></body></html>","bodyType":"html"}